# Loaded by `npm run dashboard` (vite --mode dashboard).
#
# Switches on the venue dashboard, which only exists in local development:
# it talks to a CLOAK backend running on this computer. The public build
# (npm run build, what Vercel deploys) never loads this file, so the
# dashboard is not part of the live site.

VITE_DASHBOARD=local

# The CLOAK backend (CLOAKBE) on this computer.
VITE_API_URL=http://localhost:8080
