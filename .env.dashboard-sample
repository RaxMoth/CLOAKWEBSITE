# Loaded by `npm run dashboard:sample` (vite --mode dashboard-sample).
#
# Same as .env.dashboard, but the statistics come from built-in sample
# numbers instead of GET /api/v1/stats. Use it while the backend has no
# statistics endpoint, or to work on the charts without seeded data.
# Sign-in still goes to the real backend. The dashboard shows a banner
# whenever these sample numbers are on screen.

VITE_DASHBOARD=local
VITE_API_URL=http://localhost:8080
VITE_DASHBOARD_STATS=sample
